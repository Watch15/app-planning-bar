# Modele pour l'instance de DEMONSTRATION prospects (E-21).
# Copier vers `.env.demo` (gitignore) puis renseigner MONGO_URI / SESSION_SECRET.
#
# Lancer : npm run demo:seed && npm run demo:server
# Guide : docs/guide-demo-prospect.md  ·  http://localhost:3100/demo-guide.html

MONGO_URI=mongodb+srv://USER:PASS@cluster.example.net/?appName=Cluster0
MONGO_DB=templyo_demo
NODE_ENV=development
SESSION_SECRET=change-me-demo-only
APP_URL=http://localhost:3100
PORT=3100

# Mot de passe commun des comptes semes (a changer sur l'instance Railway publique)
SEED_PASSWORD=Demo2026!

# Coupe SMS / e-mail / push — obligatoire devant un prospect
OUTBOUND_ENABLED=false
CRON_ENABLED=false

# Pack demo = toutes les options commerciales
# Formule 4 (Planning + Pointage + Performance) + echanges de shifts.
# iCal reste off (experimental, F-09) sauf besoin explicite de le montrer.
FEATURE_TIME_TRACKING=true
FEATURE_OTP_CLOSURE=true
FEATURE_PERFORMANCE=true
FEATURE_SHIFT_SWAPS=true
FEATURE_CALENDAR_SYNC=false

# Pas de CLIENT_PROFILE=castaniu : la demo generique ne doit pas allumer
# les customs Castaniu (creneaux N+1, validation hebdo).
