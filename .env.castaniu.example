# Recette dédiée aux features Castaniu (hebdo, créneaux…), JAMAIS la prod client.
#
# 1. Sur Atlas (même cluster que templyo_dev / vab3u2w) : créer la base
#    `templyo_castaniu_dev` (vide — Mongo la crée au premier insert).
# 2. Copier ce fichier en `.env.castaniu` (gitignoré) et coller le MONGO_URI
#    de recette (pas celui du cluster prod gqfynu8).
# 3. npm run castaniu:seed
# 4. npm run castaniu:server  → http://localhost:3000
#
# CLIENT_PROFILE=castaniu active les flags réservés à ce client (cf. server.js).

MONGO_URI=mongodb+srv://USER:PASS@CLUSTER/
MONGO_DB=templyo_castaniu_dev
NODE_ENV=development
SESSION_SECRET=change-me-castaniu-dev
OUTBOUND_ENABLED=false
CRON_ENABLED=false
CLIENT_PROFILE=castaniu
SEED_PASSWORD=Templyo2026!
APP_URL=http://localhost:3000
TZ=Europe/Paris

# Features Castaniu (off tant que le code n'est pas prêt — cf. docs/feature-flags.md)
FEATURE_WEEKLY_VALIDATION=false
FEATURE_PREDEFINED_SLOTS=false
