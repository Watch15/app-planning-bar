{
  "name": "app-templyo",
  "version": "3.0.0",
  "description": "Planning SaaS multi-établissements — avec authentification",
  "main": "server.js",
  "scripts": {
    "start": "node -e \"const fs=require('fs');const sw=fs.readFileSync('public/sw.js','utf8').replace('%%BUILD_TIME%%', Date.now());fs.writeFileSync('public/sw.js',sw);\" && node server.js",
    "dev": "node --watch server.js",
    "init": "node scripts/init-db.js",
    "dev:seed": "node scripts/dev-run.js scripts/seed-dev.js",
    "main:seed": "node scripts/dev-run.js --env .env.main scripts/seed-dev.js",
    "seed:all": "node scripts/seed-all.js",
    "demo:seed": "node scripts/dev-run.js --env .env.demo scripts/seed-demo.js",
    "demo:server": "node scripts/dev-run.js --env .env.demo server.js",
    "dev:server": "node scripts/dev-run.js server.js",
    "smoke": "node scripts/smoke.js",
    "create-patron": "node scripts/create-patron.js",
    "lint": "eslint .",
    "test": "node --test",
    "smoke:dev": "node scripts/smoke.js https://dev.templyo.fr --expect origin/dev",
    "smoke:main": "node scripts/smoke.js https://app-planning-bar-production.up.railway.app --expect origin/main",
    "smoke:prod": "node scripts/smoke-prod.js",
    "smoke:prod:dev": "node scripts/smoke-prod.js https://dev.templyo.fr --expect origin/dev",
    "smoke:prod:main": "node scripts/smoke-prod.js https://app-planning-bar-production.up.railway.app --expect origin/main",
    "smoke:prod:client": "node scripts/smoke-prod.js https://castaniu-family.templyo.fr --expect castanui/main",
    "db:uri:dev": "node scripts/db-uri.js .env.dev",
    "db:uri:main": "node scripts/db-uri.js .env.main",
    "link-directors": "node scripts/link-director-staff.js"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@sentry/node": "^10.48.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "helmet": "^8.1.0",
    "mongodb": "^6.3.0",
    "morgan": "^1.10.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "globals": "^17.6.0"
  }
}
